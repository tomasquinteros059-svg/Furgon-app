# Copia este archivo como supabase/functions/.env para `supabase functions serve`.
# En producción: `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase.

# --- ETA / mapas ---------------------------------------------------------
# google | mapbox | ninguno (ninguno = solo geocerca de respaldo)
ETA_PROVEEDOR=google
# Clave de SERVIDOR con "Routes API" habilitada (distinta de la clave de la app).
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Push -------------------------------------------------------------------
# Opcional: solo si activaste "Enhanced security for push notifications" en Expo.
EXPO_ACCESS_TOKEN=

# --- Llamadas (Fase 2) --------------------------------------------------------
LLAMADAS_HABILITADAS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio con capacidad de voz, formato E.164 (p. ej. +56221234567)
TWILIO_NUMERO_ORIGEN=
TWILIO_VOZ=Polly.Mia
TWILIO_IDIOMA=es-MX
# URL pública de las funciones (Twilio debe poder llegar a ella y la firma se valida
# contra esta URL). En la nube: https://<ref>.supabase.co/functions/v1
# En local: la URL de tu túnel (ngrok, cloudflared) + /functions/v1
FUNCTIONS_PUBLIC_URL=

# Secreto compartido para invocar procesar-llamadas desde pg_cron o un scheduler.
CRON_SECRET=
