# Copia como apps/movil/.env — solo valores PÚBLICOS (quedan dentro de la app).
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Claves de Google Maps SDK para la app, restringidas por paquete/bundle id.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# ID del proyecto EAS (necesario para obtener el token de push de Expo).
EAS_PROJECT_ID=
# Dirección del panel web de administración (el administrador no usa la app móvil).
EXPO_PUBLIC_PANEL_URL=https://admin.tu-dominio.cl
