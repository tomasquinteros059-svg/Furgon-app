{
  "name": "furgon-app",
  "private": true,
  "description": "Avisos autom\u00e1ticos de llegada para furgones escolares",
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:preparar": "npm run preparar --workspace=tools/simulador --",
    "simular": "npm run simular --workspace=tools/simulador --",
    "admin": "npm run dev --workspace=apps/admin",
    "admin:demo": "npm run build:demo --workspace=apps/admin",
    "desplegar": "node scripts/desplegar-supabase.mjs",
    "crear-empresa": "node scripts/crear-empresa.mjs",
    "verificar-google": "node scripts/verificar-google.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
